# Supabase 项目 URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable / anon key（可公开，靠 RLS 保护数据）
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Cloudflare Turnstile 站点密钥（可公开）。设置后登录/注册表单会渲染 CAPTCHA，
# 并把 token 传给 Supabase 校验；留空则不启用。须与 Supabase 后端 captcha 开关一致。
# 本地开发可用官方测试密钥 1x00000000000000000000AA。
VITE_TURNSTILE_SITE_KEY=

# Pages Functions 使用的 Supabase 配置。本地 Pages Functions 可放在 .dev.vars。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Pages Functions 使用的业务应用注册表。本地 Pages Functions 可放在 .dev.vars。
AUTH_APPS_JSON={"time":{"name":"Time","redirectUris":["https://time.dondone.dev/auth/callback"]}}

# 未设置或设为 'static' 时读取 AUTH_APPS_JSON；设为 'db' 时改为从 Supabase 的 oauth_client_registry 视图读取。
# 任何其他值都会以 invalid_registry_source 失败；db 模式下数据库读取失败也会直接报错，不会自动回退到 AUTH_APPS_JSON。
SERVICE_REGISTRY_SOURCE=static
