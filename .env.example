# Supabase 项目 URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable / anon key（可公开，靠 RLS 保护数据）
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Pages Functions 使用的 Supabase 配置。本地 Pages Functions 可放在 .dev.vars。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Pages Functions 使用的业务应用注册表。本地 Pages Functions 可放在 .dev.vars。
AUTH_APPS_JSON={"time":{"name":"Time","redirectUris":["https://time.dondone.dev/auth/callback"]}}
